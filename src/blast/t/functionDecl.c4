#include <tap.c4>

#include <blast/dsl.c4>

tests

is "functionDecl()" 
	&(any function declaration)/0 
	"any args renders empty parens"

is 'functionDecl(hasOverloadedOperatorName("+"))' 
	&(function operator "+" declaration)/0
	"operator renders a single operator narrower"

is 'functionDecl(hasAnyOverloadedOperatorName("+","-"))'
	&(declare function operators "+", "-", nil)
	"operators renders any operators"

is ''
	&(declare )

done_testing

