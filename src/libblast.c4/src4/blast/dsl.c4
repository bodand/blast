use "std.c4"

let -internal_recurse_matcher/4 { |m ms hs wrapper|
	let built &(m)/2 nil hs
	let str car car built
	let nhs cdr built

	cons
		cons &(wrapper)/1 str ms
		nhs
}

let +any/1 { |m| { |ms hs|
	&(m)/5 ms hs nil { |ms hs| cons cons "" ms hs } nil 
}}

let +such/2 { |obj modif| { |ms hs|
	&(obj)/5 ms hs nil modif nil
}}


let +bound/2 { |name obj| { |ms hs x y any|
	&(obj)/5 ms hs
		x 
		y 
		str_cat str_cat 
			'.bind("' name '")'
}}

let +(@#)/2 left 60 { |m name| bound name m }


let +declaration/0 \{ |ms hs decltype body bondage|
	let decl when is_nil decltype "decl" decltype

	internal_recurse_matcher body ms hs { |str|
		str_cat str_cat str_cat str_cat
			decl "(" str ")" bondage
	}
}

let +function/1 { |m| { |ms hs any body bondage|
	&(m)/5 ms hs "functionDecl" body bondage
}}

let +variable/1 { |m| { |ms hs any body bondage|
	&(m)/5 ms hs "varDecl" body bondage
}}


let +expression/0 \{ |ms hs expr_type body bondage|
	let expr when is_nil expr_type "expr" expr_type

	internal_recurse_matcher body ms hs { |str|
		str_cat str_cat str_cat str_cat
			expr "(" str ")" bondage
	}
}

let +call/1 { |m| { |ms hs any body bondage|
	&(m)/5 ms hs "callExpr" body bondage
}}


let +that/1 \|x| x

let +isnt/1 { |m| { |ms hs|
	internal_recurse_matcher m nil hs { |str|
		str_cat str_cat
			"unless(" str ")"
	}
}}
let +(~)/1 { |m| isnt m }
let +is/1 \|x| x

let -static_returning_node/1 { |str| { |ms hs|
	cons 
		cons str nil 
		hs
} }

let +named/1 { |name|
	static_returning_node str_cat str_cat 'hasName("' name '")'
}

let +auto         \static_returning_node "hasAutomaticStorageDuration()"
let +static       \static_returning_node "hasStaticStorageDuration()"
let +global       \static_returning_node "hasGlobalStorage()"
let +local        \static_returning_node "hasLocalStorage()"
let +thread_local \static_returning_node "hasThreadLocalDuration()"
let +static_local \static_returning_node "isStaticLocal()"

let +expanded/1 \|x| x

let +macro/1 { |name|
	static_returning_node str_cat str_cat 'isExpandedFromMacro("' name '")'
}

let +in/1 \|x| x

let +system_header \static_returning_node "isExpansionInSystemHeader()"

let +main_file \static_returning_node "isExpansionInMainFile()"

let +file/1 { |regex|
	static_returning_node str_cat str_cat
		'isExpansionInFileMatching("' regex '")'
}


let +calls/1 { |m| { |ms hs|
	internal_recurse_matcher m nil hs { |str|
		str_cat str_cat
			"callee(" str ")"
	}
}}

let -fmt_list/3 { |l ms hs|
	let head car l
	let tail cdr l

	if is_nil head nil
	else {
		let built &(head)/2 nil hs
		let str car car built
		let nhs cdr built

		let rec fmt_list tail nil nhs
		let tailstr car car rec
		let nnhs cdr rec

		when is_nil car tail
			cons
				cons str ms
				nhs
		else
			cons
				cons
					str_cat str_cat
						str ", " tailstr
					ms
				nhs
	}
}

let -list_matcher/3 { |list prefix suffix| { |ms hs|
	let built fmt_list list ms hs
	let str car car built
	let nms cdr car built
	let nhs cdr built

	cons
		cons
			str_cat str_cat
				prefix str suffix
			nms
		nhs
}}

let +which/1 { |list|
	list_matcher list "" ""
}

let +allOf/1 { |list|
	list_matcher list "allOf(" ")"
}

let +eachOf/1 { |list|
	list_matcher list "eachOf(" ")"
}

let +anyOf/1 { |list|
	list_matcher list "anyOf(" ")"
}

