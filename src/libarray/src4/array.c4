/* Library for providing native array functions. Primarily used for interfacing
 * with native code that requires multiple values. Passing lists is painful.
 *
 * Version: 1.0.0
 */

let native new_array/0;
let native new_array_sized/1;
let native new_array_capacity/1;

let native array_push/2;

let list_to_array/1 { |list|
    let arr new_array
    arr

    for_each list { |x| array_push arr x }
    arr
}
