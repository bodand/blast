let tests/1 { |tests|
	let init
		bst_insert "start" 1
		bst_insert "end" 0
		nil
	
	&(tests)/1 init
}

let next_count/1 { |state|
	(state."start") + (state."end")
}

let step_state/1 { |state|
	bst_insert "end" 1 + (state."end") state
}

let run_test_case/4 { |cond count msg skip|
	if skip {
		io_println str_cat "ok "
		           str_cat count
		           str_cat " - " 
		           str_cat msg 
		                   " # SKIP"
	}
	else {
		io_print when cond "ok " "not ok "
		io_println str_cat count
					  str_cat " - "
								 msg
	}
}

let ok/3 { |val msg K| { |state|
	let count next_count state
	let next step_state state

	run_test_case val count msg false

	&(K)/1 next
}}

let is/4 { |a b msg K| { |state|
	let count next_count state
	let next step_state state

	run_test_case (&(b)/0 == &(a)/0) count msg false

	&(K)/1 next
}}

let done_testing \{ |state| 
	io_println str_cat state."start" str_cat ".." state."end" 
}

