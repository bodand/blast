# vim: nospell

Eobj: box thick "C4_External obj" big fit color orange

Eempty: box "clang::ASTUnit*" big wid Eobj.wid height Eobj.height with .s at 1 above Eobj.n color orange
Efin: box "+finalizer" big fit color orange with .se at Eempty.ne

arrow from Eobj.n to Eempty.s color orange

Ptr: box dashed thick "std::unique_ptr<>" big wid Eobj.wid height Eobj.height with .w at 1 right of Eobj.e color green

line from Ptr.n color green then .356 heading 10
F: dot invis at last line.end

line from F then .15 heading -80 color green
line from F then .15 heading 100 color green

line invis from F then .05 heading 10
F: dot invis at last line.end

line from F then .15 heading -80 color green
line from F then .15 heading 100 color green

Ast: box thick "clang::ASTUnit" big wid Eobj.wid height Eobj.height with .s at 1 above Ptr.n color orange

arrow from Eempty.e to Ast.w color orange

line dotted from Eobj.sw - (.2,.2) then right 1.6 \
  then up until even with Ast.s - (0,.2) \
  then right until even with Ast.e + (.2,0) \
  then up until even with Efin.n \
  then up .2 \
  then left until even with Eobj.sw - (.2,.2) \
  then down to Eobj.sw - (.2,.2) \
  color orange
text "GC kontextus" big bold color orange with .sw at 7th vertex of last line

line dotted from Ptr.sw - (.2,.2) then right 1.6 \
  then up until even with F + (0,.1) \
  then left until even with Ptr.sw - (.2,.2) \
  then down to Ptr.sw - (.2,.2) \
  color green
text "Clang RAII" big bold color green with .sw at 4th vertex of last line

