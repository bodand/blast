ind = 8pt
ln = 10pt

C4:   box fill lightgray ht 1.643cm wid 4.431cm
Let0: text with .w at C4.nw - (.12  - 0*ind, .1 + 0*ln) "let add/2 { |a b|" big monospace 
Let1: text with .w at C4.nw - (-.01 - 1*ind, .1 + 1*ln) "a + b"             big monospace 
Let2: text with .w at C4.nw - (-.04 - 0*ind, .1 + 2*ln)  "}"                big monospace
Call: text with .w at C4.nw - (.023 - 0*ind, .1 + 3*ln) "add 1 2"           big monospace

move 4.431cm


AST: box fill lightgray ht 3.14cm wid 6.513cm
     text with .w at AST.nw - (.1   - 0*ind, .12 + 0*ln) "(scope [+/2->]"                 big monospace
     text with .w at AST.nw - (.09  - 1*ind, .12 + 1*ln) "(let add/2@60"                  big monospace
     text with .w at AST.nw - (.1   - 2*ind, .12 + 2*ln) "(scope [+/2->]"                 big monospace
L0:  text with .w at AST.nw - (.191 - 3*ind, .12 + 3*ln) "(lambda [a/0#B0 b/0#18]"        big monospace
     text with .w at AST.nw - (.1   - 4*ind, .12 + 4*ln) "(scope [+/2->]"                 big monospace
P0:  text with .w at AST.nw - (.259 - 5*ind, .12 + 5*ln) "(+/2 (a/0->B0) (b/0->18)))))))" big monospace
C0:  text with .w at AST.nw - (.142 - 0*ind, .12 + 6*ln) "(scope [add/2->60]" big monospace
C1:  text with .w at AST.nw - (.119 - 1*ind, .12 + 7*ln) "(add/2->60 1 2))" big monospace

S0: line invisible \
    from    Call.nw - (-.1, .07) \ 
    then to Call.ne - (.1, .07) \
    then to C0.nw   - (-.2, .06) \
    then to C0.ne   - (.2, .06) \
    then down 2*ln \
    then left until even with C0.nw - (-.2, .07) \
    then to Call.se - (.1, -.05) \
    then right until even with Call.nw - (-.1, .07) \
    close

line color 0xc63131 \
  from 5st vertex of S0 \
  to 6nd vertex of S0 \
  then to 7rd vertex of S0 \
  then to 8th vertex of S0

line color 0x18a52b \
  from Let0.s + (.1, .04) \
    to Let0.s + (.55, .04) \
  then to L0.sw + (.2, .04) \
  then to L0.se + (-.23, .04)

line color 0x4674fc \
  from Let1.sw + (.08, .06) \
    to Let1.sw + (.42, .06) \
  then to P0.sw + (.3, .04) \
  then to P0.se + (-.65, .04)

